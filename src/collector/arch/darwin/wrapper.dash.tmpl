#!/bin/dash
# trocar install-folder wrapper (spec 4.11 P8; lab M4: /bin/dash, not /bin/sh — bash-as-sh drops `_` and OLDPWD and adds SHLVL).
# Written by `trocar install` where the agent's program was; the program itself was moved to .trocar-real/ beside it under the same name.
# Without the switch file: the certificate variable is set only when it is unset, and the real program runs with the same argv,
# stdio and exit code (exec). With the switch file: TROCAR_PRIOR_PROXY records the agent's own proxy (the first set name of its
# precedence list that is not the door; `none` when none is set) and the agent's proxy names point at the door the switch file holds.
# The script sets no variable of its own: its working names are function locals, restored before exec.
trocar_cert() {
  local n
  n=__TROCAR_CERT_VAR__
  eval "[ -n \"\${$n-}\" ]" || eval "$n=\$1; export $n"
}
trocar_route() {
  local d k v p s
  IFS= read -r d 2>/dev/null <"$1" || [ -n "$d" ] || return 0
  [ -n "$d" ] || return 0
  p= s=
  for k in __TROCAR_PROXY_ENV__; do
    eval "v=\${$k-}"
    if [ -n "$v" ] && [ "$v" != "$d" ]; then p=$v; break; fi
    [ -n "$v" ] && s=1
  done
  if [ -n "$p" ]; then TROCAR_PRIOR_PROXY=$p
  elif [ -z "$s" ] || [ -z "${TROCAR_PRIOR_PROXY-}" ]; then TROCAR_PRIOR_PROXY=none
  fi
  export TROCAR_PRIOR_PROXY
  for k in __TROCAR_PROXY_NAMES__; do eval "$k=\$d; export $k"; done
}
trocar_cert __TROCAR_CA_FILE__
if [ -f __TROCAR_SWITCH__ ]; then trocar_route __TROCAR_SWITCH__; fi
exec __TROCAR_REAL__ "$@"
