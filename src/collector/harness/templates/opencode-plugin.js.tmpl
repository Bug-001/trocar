// trocar collector: routing plugin for OpenCode (its mark, which off finds it by when the install manifest is gone; spec 4.11 P9 `opencode-plugin`). Written by
// `trocar on` into OpenCode's plugin folder with the door baked in, deleted by `off`. Routing only (the root is in the user's trust store):
//   at import — TROCAR_PRIOR_PROXY records this process's own proxy (the first set name of OpenCode's precedence list that is not the door;
//               `none` when none is set), and both spellings of the https proxy point at the door (Bun reads them per request);
//               the bypass list (both spellings) becomes loopback ∪ its own value (P6), so OpenCode's own loopback server — the ACP
//               client talks to it over plain http, which follows HTTP_PROXY in Bun — is never sent to the door (macOS test machine, 2026-10-17);
//   fetch     — wrapped so an https request to a non-loopback host that names no proxy of its own carries `proxy: <door>` (the TUI and the
//               VS Code form need this; http and loopback calls — OpenCode's own server — are left alone).
// It reads and changes no request or response bytes, connects nowhere itself, writes no file, never throws. Both module shapes are exported:
// the 1.x named async function and the v2 default { id, server } (no `effect`: v2 2.0.29 broke its transport when one was given); the
// work is done at import either way, because v2 evaluates plugin modules without calling them.
const DOOR = __TROCAR_DOOR__
const PROXY_ENV = __TROCAR_PROXY_ENV__
const PROXY_NAMES = __TROCAR_PROXY_NAMES__
const NO_PROXY_ENV = __TROCAR_NO_PROXY_ENV__
const LOOPBACK_HOSTS = ['localhost', '127.0.0.1', '::1'] // P6, the same three as entries.mjs LOOPBACK
const LOOPBACK = /^(localhost|127(\.\d+){3}|\[::1\]|::1)$/i

try {
  const env = process.env
  let prior = null, sawDoor = false
  for (const k of PROXY_ENV) { const v = env[k]; if (!v) continue; if (v !== DOOR) { prior = v; break } sawDoor = true }
  if (prior) env.TROCAR_PRIOR_PROXY = prior
  else if (!sawDoor || !env.TROCAR_PRIOR_PROXY) env.TROCAR_PRIOR_PROXY = 'none'
  for (const k of PROXY_NAMES) env[k] = DOOR
} catch { /* a plugin never stops its host */ }

try { // P6: loopback ∪ the bypass list this process already has; case-insensitive dedupe, first spelling and order kept
  const env = process.env, seen = new Set(), hosts = []
  for (const v of [LOOPBACK_HOSTS.join(','), ...NO_PROXY_ENV.map((k) => env[k])]) {
    for (const h of String(v || '').split(',').map((x) => x.trim()).filter(Boolean)) if (!seen.has(h.toLowerCase())) { seen.add(h.toLowerCase()); hosts.push(h) }
  }
  for (const k of NO_PROXY_ENV) env[k] = hosts.join(',')
} catch { /* a plugin never stops its host */ }

try {
  const inner = globalThis.fetch
  if (typeof inner === 'function' && !inner.trocarDoor) {
    const fetch = function (input, init) {
      let url = null
      try { url = new URL(typeof input === 'string' ? input : input instanceof URL ? input.href : input.url) } catch { /* not a URL: as it was */ }
      if (url && url.protocol === 'https:' && !LOOPBACK.test(url.hostname) && !(init && init.proxy)) return inner.call(this, input, { ...init, proxy: DOOR })
      return inner.call(this, input, init)
    }
    for (const k of Object.getOwnPropertyNames(inner)) { // e.g. Bun's fetch.preconnect
      if (!['length', 'name', 'prototype', 'arguments', 'caller'].includes(k)) Object.defineProperty(fetch, k, Object.getOwnPropertyDescriptor(inner, k))
    }
    Object.defineProperty(fetch, 'trocarDoor', { value: DOOR })
    globalThis.fetch = fetch
  }
} catch { /* a plugin never stops its host */ }

export const TrocarRoute = async () => ({})
export default { id: 'trocar-route', server: TrocarRoute }
