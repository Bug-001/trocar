{
  "name": "asight",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "asight — transparent, byte-faithful, cross-provider tracer of what an agent app really sends the LLM (product build).",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "asight": "bin/asight.mjs"
  },
  "files": [
    "src/",
    "bin/",
    "README.md"
  ],
  "scripts": {
    "test": "node --test --test-force-exit --require ./test/helpers/flush-exit.cjs --require ./test/helpers/leak-guard.cjs --require ./test/helpers/no-real-os.cjs",
    "lab:linux:vm": "LAB_VM=1 node --test --test-force-exit --test-concurrency=1 --require ./test/helpers/flush-exit.cjs"
  },
  "dependencies": {}
}
