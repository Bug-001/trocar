{
  "name": "asight",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "asight — transparent, byte-faithful, cross-provider tracer of what an agent app really sends the LLM (product build).",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "asight": "bin/asight.mjs"
  },
  "files": [
    "src/",
    "bin/",
    "README.md"
  ],
  "scripts": {
    "test": "node --test --test-force-exit --import ./test/helpers/flush-exit.mjs",
    "etl": "node src/etl/cli.mjs",
    "serve": "node src/server.mjs",
    "demo": "node src/server.mjs --source samples/demo-session.ndjson"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.4-r.1"
  }
}
